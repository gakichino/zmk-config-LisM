#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt3: mod_tap3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mac_onsei {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <5 6>;
            layers = <0>;
        };

        win_onsei {
            bindings = <&kp LG(H)>;
            key-positions = <5 6>;
            layers = <1>;
        };

        to_win_system {
            bindings = <&mo 6>;
            key-positions = <34 35>;
            layers = <1>;
        };

        to_mac_system {
            bindings = <&mo 5>;
            key-positions = <34 35>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <25 26>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_default {
            display-name = "mDefault";
            bindings = <
&kp Q                     &kp W             &kp E             &kp R           &kp T                                                           &kp Y                  &kp U            &kp I         &kp O         &kp P
&mt LCTRL A               &kp S             &kp D             &kp F           &kp G                                                           &kp H                  &kp J            &kp K         &kp L         &mt2 RCTRL SEMI
&mt2 LEFT_SHIFT Z         &kp X             &kp C             &kp V           &kp B                                                           &kp N                  &kp M            &kp COMMA     &kp DOT       &lt 2 SLASH
&mt2 LEFT_ALT LANGUAGE_1  &kp LC(UP_ARROW)  &kp LC(UP_ARROW)  &kp ESCAPE      &lt 3 SPACE      &mt2 LEFT_GUI TAB    &mt3 RIGHT_GUI BACKSPACE  &mt2 LEFT_SHIFT ENTER  &kp RIGHT_SHIFT  &kp LC(DOWN)  &kp LC(DOWN)  &mt2 RIGHT_ALT LANG2
                                            &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_RIGHT                                                 &kp C_VOL_DN           &kp C_VOL_UP     &kp C_MUTE
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        win_default {
            display-name = "wDefault";
            bindings = <
&trans  &trans       &trans       &trans  &trans                                                     &trans  &trans  &trans           &trans           &trans
&trans  &trans       &trans       &trans  &trans                                                     &trans  &trans  &trans           &trans           &trans
&trans  &trans       &trans       &trans  &trans                                                     &trans  &trans  &trans           &trans           &trans
&trans  &kp LG(TAB)  &kp LG(TAB)  &trans  &trans  &mt3 LEFT_CONTROL TAB    &mt2 RIGHT_GUI BACKSPACE  &trans  &trans  &kp LC(LA(TAB))  &kp LC(LA(TAB))  &trans
                     &trans       &trans  &trans                                                     &trans  &trans  &trans
            >;
        };

        numbers_arrows {
            display-name = "numbers";
            bindings = <
&kp SLASH                 &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                                     &none                      &kp BSPC       &kp DELETE    &kp TAB    &trans
&kp ASTERISK              &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS                                      &kp LEFT                   &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
&mt2 LEFT_SHIFT NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                                     &kp HOME                   &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &trans
&trans                    &trans        &trans        &kp SPACE     &lt 4 DOT  &mt3 LEFT_GUI BACKSPACE    &trans  &mt2 LEFT_SHIFT LS(ENTER)  &trans         &trans        &trans     &trans
                                        &trans        &trans        &trans                                        &trans                     &trans         &trans
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        symbols {
            display-name = "symbols";
            bindings = <
&kp QUESTION  &kp DOUBLE_QUOTES  &kp EXCLAMATION  &kp BSPC  &kp TILDE                    &none      &kp UNDER  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERCENT
&kp AT        &kp SQT            &kp DOLLAR       &kp DEL   &kp FSLH                     &kp HASH   &none      &kp LBKT              &kp RBKT               &kp RIGHT_CONTROL
&kp LSHFT     &kp GRAVE          &kp CARET        &kp PIPE  &kp BSLH                     &kp ASTRK  &kp AMPS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &mo 4
&trans        &trans             &trans           &none     &trans     &trans    &trans  &trans     &trans     &trans                &trans                 &trans
                                 &trans           &trans    &trans                       &trans     &trans     &trans
            >;
        };

        fnc_navi {
            display-name = "functions";
            bindings = <
&kp C_MUTE              &kp F7  &kp F8  &kp F9  &kp F12                      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
&kp C_PP                &kp F4  &kp F5  &kp F6  &kp F11                      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&mt2 LEFT_SHIFT C_STOP  &kp F1  &kp F2  &kp F3  &kp F10                      &none           &kp LEFT_GUI    &kp LCTRL     &kp LEFT_ALT     &trans
&none                   &trans  &trans  &trans  &trans   &trans    &mkp MB1  &mkp MB3        &mkp MB2        &trans        &trans           &trans
                                &trans  &trans  &trans                       &trans          &trans          &trans
            >;
        };

        mac_bt_shortcuts {
            display-name = "system_mac";
            bindings = <
&sys_reset           &bootloader   &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))                      &none   &to 0   &to 1   &bootloader  &sys_reset
&none                &bt BT_SEL 4  &out OUT_TOG          &none                 &kp LEFT_CONTROL                    &none   &none   &none   &bt BT_CLR   &bt BT_CLR_ALL
&bt BT_SEL 0         &bt BT_SEL 1  &bt BT_SEL 2          &bt BT_SEL 3          &none                               &none   &none   &none   &none        &none
&kp LA(LG(C_POWER))  &trans        &trans                &trans                &trans            &trans    &trans  &trans  &trans  &trans  &trans       &trans
                                   &trans                &trans                &trans                              &trans  &trans  &trans
            >;
        };

        win_bt_shortcuts {
            display-name = "system_win";
            bindings = <
&sys_reset    &bootloader   &kp LG(PRINTSCREEN)  &kp LG(LS(S))  &kp LG(LS(S))                    &none   &to 0   &to 1   &bootloader  &sys_reset
&none         &bt BT_SEL 4  &out OUT_TOG         &none          &kp LG(H)                        &none   &none   &none   &bt BT_CLR   &bt BT_CLR_ALL
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2         &bt BT_SEL 3   &none                            &none   &none   &none   &none        &none
&kp LG(L)     &trans        &trans               &trans         &trans         &trans    &trans  &trans  &trans  &trans  &trans       &trans
                            &trans               &trans         &trans                           &trans  &trans  &trans
            >;
        };

        auto_mouse {
            display-name = "mouse";
            bindings = <
&trans  &trans    &mo 2     &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans                    &trans  &mouse_gesture  &trans  &trans  &trans
&trans  &trans    &trans    &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                  &trans    &trans    &trans                    &trans  &trans  &trans
            >;
        };
    };
};
