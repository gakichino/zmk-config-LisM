#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

&lt { quick-tap-ms = <200>; };

/ {
    macros {
        // 閉じ → カーソル1つ左
        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp RIGHT_PARENTHESIS &kp LEFT>;
        };
        brkt_pair: brkt_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp RBKT &kp LEFT>;
        };
        brace_pair: brace_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp RIGHT_BRACE &kp LEFT>;
        };
    };

    behaviors {
        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt3: mod_tap3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mac_onsei {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <5 6>;
            layers = <0>;
        };

        win_onsei {
            bindings = <&kp LG(H)>;
            key-positions = <5 6>;
            layers = <1>;
        };

        to_win_system {
            bindings = <&mo 6>;
            key-positions = <34 35>;
            layers = <1>;
        };

        to_mac_system {
            bindings = <&mo 5>;
            key-positions = <34 35>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <25 26>;
            layers = <0 1>;
        };

        mb1 {
            bindings = <&mkp MB1>;
            key-positions = <3 13>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <2 12>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <1 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_default {
            display-name = "mDefault";
            bindings = <
&kp Q                     &kp W  &kp E           &kp R           &kp T                                                           &kp Y                  &kp U            &kp I       &kp O    &kp P
&mt LCTRL A               &kp S  &kp D           &kp F           &kp G                                                           &kp H                  &kp J            &kp K       &kp L    &mt2 RCTRL SEMI
&mt2 LEFT_SHIFT Z         &kp X  &kp C           &kp V           &kp B                                                           &kp N                  &kp M            &kp COMMA   &kp DOT  &lt 2 SLASH
&mt2 LEFT_ALT LANGUAGE_1  &none  &none           &kp ESCAPE      &lt 3 SPACE      &mt2 LEFT_GUI TAB    &mt3 RIGHT_GUI BACKSPACE  &mt2 LEFT_SHIFT ENTER  &kp RIGHT_SHIFT  &none       &none    &mt2 RIGHT_ALT LANG2
                                 &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                                                 &kp C_VOL_DN           &kp C_VOL_UP     &kp C_MUTE
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        win_default {
            display-name = "wDefault";
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                                     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                                     &trans  &trans  &trans  &trans  &trans
&trans  &none   &none   &trans  &trans  &mt3 LEFT_CONTROL TAB    &mt2 RIGHT_GUI BACKSPACE  &trans  &trans  &none   &none   &trans
                &trans  &trans  &trans                                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        numbers_arrows {
            display-name = "numbers";
            bindings = <
&kp SLASH                 &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                                     &none                      &kp BSPC       &kp DELETE    &kp TAB    &trans
&kp ASTERISK              &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS                                      &kp LEFT                   &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
&mt2 LEFT_SHIFT NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                                     &kp HOME                   &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &trans
&trans                    &trans        &trans        &kp SPACE     &lt 4 DOT  &mt3 LEFT_GUI BACKSPACE    &trans  &mt2 LEFT_SHIFT LS(ENTER)  &trans         &trans        &trans     &trans
                                        &trans        &trans        &trans                                        &trans                     &trans         &trans
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        symbols {
            display-name = "symbols";
            bindings = <
&kp QUESTION  &kp DOUBLE_QUOTES  &kp EXCLAMATION  &kp BSPC  &kp TILDE                    &none      &kp UNDER  &kp LEFT_PARENTHESIS  &paren_pair  &kp PERCENT
&kp AT        &kp SQT            &kp DOLLAR       &kp DEL   &kp FSLH                     &kp HASH   &none      &kp LBKT              &brkt_pair   &kp RIGHT_CONTROL
&kp LSHFT     &kp GRAVE          &kp CARET        &kp PIPE  &kp BSLH                     &kp ASTRK  &kp AMPS   &kp LEFT_BRACE        &brace_pair  &mo 4
&trans        &trans             &trans           &none     &trans     &trans    &trans  &trans     &trans     &trans                &trans       &trans
                                 &trans           &trans    &trans                       &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        fnc_navi {
            display-name = "functions";
            bindings = <
&kp C_MUTE              &kp F7  &kp F8  &kp F9  &kp F12                      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
&kp C_PP                &kp F4  &kp F5  &kp F6  &kp F11                      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&mt2 LEFT_SHIFT C_STOP  &kp F1  &kp F2  &kp F3  &kp F10                      &none           &kp LEFT_GUI    &kp LCTRL     &kp LEFT_ALT     &trans
&none                   &trans  &trans  &trans  &trans   &trans    &mkp MB1  &mkp MB3        &mkp MB2        &trans        &trans           &trans
                                &trans  &trans  &trans                       &trans          &trans          &trans
            >;
        };

        mac_bt_shortcuts {
            display-name = "system_mac";
            bindings = <
&sys_reset           &bootloader  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none                &none        &out OUT_TOG          &none                 &kp LEFT_CONTROL                    &none         &to 0         &to 1         &bt BT_CLR    &bt BT_CLR_ALL
&none                &none        &none                 &none                 &none                               &none         &none         &none         &none         &none
&kp LA(LG(C_POWER))  &trans       &trans                &trans                &trans            &trans    &trans  &trans        &trans        &trans        &trans        &trans
                                  &trans                &trans                &trans                              &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>;
        };

        win_bt_shortcuts {
            display-name = "system_win";
            bindings = <
&sys_reset  &bootloader  &kp LG(PRINTSCREEN)  &kp LG(LS(S))  &kp LG(LS(S))                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none       &none        &out OUT_TOG         &none          &kp LG(H)                        &none         &to 0         &to 1         &bt BT_CLR    &bt BT_CLR_ALL
&none       &none        &none                &none          &none                            &none         &none         &none         &none         &none
&kp LG(L)   &trans       &trans               &trans         &trans         &trans    &trans  &trans        &trans        &trans        &trans        &trans
                         &trans               &trans         &trans                           &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        auto_mouse {
            display-name = "mouse";
            bindings = <
&trans  &mo 2   &trans  &trans  &trans                    &mouse_gesture  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans          &trans  &trans
            >;
        };
    };
};
